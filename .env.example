# Add your environment variables here.
# Each var must also be declared in src/lib/server/env.server.ts so it
# gets validated at boot. Never read process.env / Bun.env directly elsewhere.

# Convex deployment URL for the client (written to .env.local by `bunx convex dev`).
PUBLIC_CONVEX_URL=

# Shared password for the /login gate.
APP_PASSWORD=

# Shared secret required by every public Convex function.
# Must match the APP_TOKEN env var configured in the Convex dashboard.
APP_TOKEN=
