{
	"name": "kucharka",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "bunx --bun vite build",
		"preview": "bunx --bun vite preview",
		"preview:node": "HOST=127.0.0.1 PORT=4173 ORIGIN=http://localhost:4173 node build/index.js",
		"prepare": "bunx svelte-kit sync",
		"check": "bunx svelte-kit sync && bunx svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bunx svelte-kit sync && bunx svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "bunx prettier --write .",
		"lint": "bunx prettier --check . && bunx eslint .",
		"test:unit": "bunx vitest run",
		"test:unit:watch": "bunx vitest",
		"test:server": "bunx vitest run --project server",
		"test:server:watch": "bunx vitest --project server",
		"test:server:coverage": "bunx vitest run --project server --coverage --coverage.reportsDirectory=./coverage/server",
		"test:browser": "bunx vitest run --project client",
		"test:browser:watch": "bunx vitest --project client",
		"test:browser:coverage": "bunx vitest run --project client --coverage --coverage.reportsDirectory=./coverage/browser",
		"test:coverage": "bunx vitest run --coverage",
		"test": "bun run check && bun run lint && bun run test:unit",
		"cypress:run": "cypress run",
		"cypress:open": "cypress open",
		"e2e": "bun run build && start-server-and-test preview:node http://127.0.0.1:4173 cypress:run",
		"e2e:open": "bun run build && start-server-and-test preview:node http://127.0.0.1:4173 cypress:open",
		"changeset": "bunx changeset",
		"changeset:add": "bunx changeset add",
		"changeset:version": "bunx changeset version",
		"changeset:publish": "bunx changeset publish",
		"check:changeset": "bunx changeset status --since=origin/main"
	},
	"dependencies": {
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"convex": "^1.42.3",
		"convex-svelte": "^0.14.0",
		"pino": "^10.3.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.27.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/cypress": "^10.1.3",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.2",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-istanbul": "^4.1.10",
		"cypress": "^15.19.0",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"pino-pretty": "^13.1.3",
		"playwright": "^1.62.0",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"start-server-and-test": "^3.0.11",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"svelte-sonner": "^1.1.1",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^7.3.6",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^2.2.1",
		"xlsx": "^0.18.5"
	}
}
